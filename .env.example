PORT=3000
NODE_ENV=development
# Bắt buộc đặt giá trị bí mật riêng, dài ít nhất 32 ký tự, trong production.
SESSION_SECRET=
DB_FILE=data/vcraft.db
# Production: không nạp tài khoản demo; admin đầu tiên tạo từ hai biến sau (mật khẩu >= 12 ký tự).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production đặt trust proxy = 1 và cookie secure: bắt buộc chạy sau reverse proxy HTTPS
# gửi X-Forwarded-Proto, nếu không trình duyệt sẽ không nhận cookie phiên.
