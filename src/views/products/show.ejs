<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="site-main product-detail-page">
  <div class="container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="Đường dẫn">
      <ol class="breadcrumb-list">
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/catalog">Bộ sưu tập</a></li>
        <li><a href="/catalog?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a></li>
        <li aria-current="page"><%= product.name %></li>
      </ol>
    </nav>

    <!-- Product Top Section: Media & Primary Info -->
    <div class="product-showcase-grid">
      <!-- Media Gallery Column -->
      <div class="product-gallery-column">
        <div class="main-image-wrap image-frame" id="main-image-wrap">
          <img
            src="<%= product.hero_image || 'https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?auto=format&fit=crop&w=1200&q=80' %>"
            alt="<%= product.name %>"
            id="main-product-image"
            class="main-image"
          >
          <% if (product.status === 'draft') { %>
            <span class="draft-badge-watermark">BẢN NHÁP (Chưa xuất bản)</span>
          <% } %>
        </div>

        <% if (product.images && product.images.length > 0) { %>
          <div class="thumbs-strip" role="group" aria-label="Hình ảnh chi tiết tác phẩm">
            <!-- Hero image thumb -->
            <button
              type="button"
              class="thumb-btn active"
              data-img-src="<%= product.hero_image %>"
              aria-label="Xem ảnh chính"
            >
              <img src="<%= product.hero_image %>" alt="<%= product.name %> - Ảnh chính" class="thumb-img">
            </button>
            <% product.images.forEach(function(img, idx) { %>
              <button
                type="button"
                class="thumb-btn"
                data-img-src="<%= img.image_path %>"
                aria-label="Xem ảnh chi tiết <%= idx + 1 %>"
              >
                <img src="<%= img.image_path %>" alt="<%= img.alt_text || product.name %>" class="thumb-img">
              </button>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- Info Column -->
      <div class="product-info-column">
        <div class="product-header-group">
          <div class="product-badges-row">
            <span class="category-pill"><%= product.category %></span>
            <% if (product.inventory > 0) { %>
              <span class="status-badge status-approved">Còn hàng (<%= product.inventory %> sản phẩm)</span>
            <% } else { %>
              <span class="status-badge status-suspended">Tạm hết hàng</span>
            <% } %>
            <% if (product.status === 'draft') { %>
              <span class="badge badge-warning">Bản nháp</span>
            <% } %>
          </div>

          <span class="slide-kicker">Tuyệt Tác Thủ Công</span>
          <h1 class="product-title"><%= product.name %></h1>
          <div class="editorial-rule"></div>
          <!-- Workshop Info Card -->
          <div class="product-artisan-card paper-panel">
            <div class="artisan-avatar-placeholder">
              <span><%= (product.workshop_name || product.artisan_name || 'V').charAt(0) %></span>
            </div>
            <div class="artisan-info-text">
              <span class="artisan-sub-label">Chế tác thủ công bởi</span>
              <h3 class="artisan-workshop-link">
                <% if (product.workshop_slug) { %>
                  <a href="/workshops/<%= product.workshop_slug %>"><%= product.workshop_name %></a>
                <% } else { %>
                  <span><%= product.artisan_name %></span>
                <% } %>
              </h3>
              <span class="artisan-name">Nghệ nhân: <%= product.artisan_name %></span>
            </div>
          </div>
        </div>

        <!-- Price -->
        <div class="product-pricing-box paper-panel">
          <span class="price-label">Giá niêm yết:</span>
          <span class="price-value">
            <%= typeof formatCurrency === 'function' ? formatCurrency(product.price) : Number(product.price).toLocaleString('vi-VN') + ' ₫' %>
          </span>
          <span class="price-vat-note">(Đã bao gồm thuế & hỗ trợ đóng gói bảo hiểm nghệ thuật)</span>
        </div>

        <!-- Description -->
        <div class="product-description-wrap">
          <h3 class="section-subheading">Mô tả tác phẩm</h3>
          <div class="product-desc-text formatted-text">
            <p><%= product.description %></p>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="product-action-buttons">
          <a href="/quotes/new" class="btn btn-primary btn-lg btn-block">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            Yêu cầu Báo giá & Đặt làm riêng
          </a>

          <div class="secondary-actions-row">
            <a href="/products/<%= product.slug %>/story" class="btn btn-outline btn-block">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 14 14"></polyline>
              </svg>
              Xem Nhật ký chế tác (Provenance Story)
            </a>

            <a href="/products/<%= product.slug %>/qr.png" target="_blank" class="btn btn-secondary" title="Mở mã QR chứng thực">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              Mã QR
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Provenance & Production Timeline Highlights -->
    <section class="section product-provenance-section">
      <div class="provenance-showcase-card paper-panel">
        <div class="provenance-header">
          <div>
            <span class="heritage-label">Căn cước tác phẩm</span>
            <h2 class="provenance-section-title section-script-title">Nhật ký Chế tác <span class="display-script">&amp; Nguồn gốc</span></h2>
            <p class="provenance-section-desc">
              Tác phẩm này được bảo chứng bằng nhật ký từng công đoạn thực hiện trực tiếp tại xưởng nghề.
            </p>
          </div>
          <div class="qr-thumbnail-box">
            <a href="/products/<%= product.slug %>/qr.png" target="_blank" class="qr-code-link" title="Bấm để mở ảnh mã QR kích thước đầy đủ">
              <img
                src="/products/<%= product.slug %>/qr.png"
                alt="Mã QR tra cứu nguồn gốc cho tác phẩm <%= product.name %>"
                class="qr-code-img"
              >
            </a>
            <span class="qr-caption">Quét để xem Nhật ký</span>
          </div>
        </div>

        <% if (product.steps && product.steps.length > 0) { %>
          <div class="mini-timeline-container">
            <div class="mini-timeline-track">
              <% product.steps.forEach(function(step, idx) { %>
                <div class="mini-timeline-step">
                  <div class="step-marker"><%= idx + 1 %></div>
                  <div class="step-info">
                    <span class="step-time">
                      <%= typeof formatDate === 'function' ? formatDate(step.occurred_at) : new Date(step.occurred_at).toLocaleDateString('vi-VN') %>
                    </span>
                    <h4 class="step-title"><%= step.title %></h4>
                    <% if (step.image_path) { %>
                      <div class="step-photo-preview">
                        <img src="<%= step.image_path %>" alt="<%= step.title %>" class="step-mini-img">
                      </div>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
          <div class="provenance-full-link-wrap">
            <a href="/products/<%= product.slug %>/story" class="btn btn-outline">
              Xem toàn cảnh hành trình chế tác với đầy đủ tư liệu &rarr;
            </a>
          </div>
        <% } else { %>
          <div class="empty-steps-notice">
            <p>Nghệ nhân đang trong quá trình chuẩn bị hồ sơ tư liệu cho các công đoạn chế tác tiếp theo của tác phẩm này.</p>
            <a href="/products/<%= product.slug %>/story" class="btn btn-outline btn-sm">Xem trang xác thực nguồn gốc</a>
          </div>
        <% } %>
      </div>
    </section>

    <!-- Related Products -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
      <section class="section related-products-section">
        <div class="section-header">
          <div>
            <span class="section-eyebrow">Cùng danh mục <%= product.category %></span>
            <h2 class="section-title">Tác phẩm liên quan</h2>
          </div>
          <a href="/catalog?category=<%= encodeURIComponent(product.category) %>" class="section-link">Xem tất cả &rarr;</a>
        </div>

        <div class="grid grid-4 product-grid">
          <% relatedProducts.forEach(function(rel) { %>
            <article class="product-card">
              <a href="/products/<%= rel.slug %>" class="product-card-media">
                <img
                  src="<%= rel.hero_image || 'https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?auto=format&fit=crop&w=800&q=80' %>"
                  alt="<%= rel.name %>"
                  class="product-card-img"
                  loading="lazy"
                >
                <span class="product-category-badge"><%= rel.category %></span>
              </a>
              <div class="product-card-body">
                <div class="product-workshop-name">
                  <% if (rel.workshop_slug) { %>
                    <a href="/workshops/<%= rel.workshop_slug %>"><%= rel.workshop_name || rel.artisan_name %></a>
                  <% } else { %>
                    <span><%= rel.artisan_name %></span>
                  <% } %>
                </div>
                <h3 class="product-card-title">
                  <a href="/products/<%= rel.slug %>"><%= rel.name %></a>
                </h3>
                <div class="product-card-footer">
                  <span class="product-price">
                    <%= typeof formatCurrency === 'function' ? formatCurrency(rel.price) : Number(rel.price).toLocaleString('vi-VN') + ' ₫' %>
                  </span>
                  <a href="/products/<%= rel.slug %>" class="btn btn-sm btn-outline">Chi tiết</a>
                </div>
              </div>
            </article>
          <% }); %>
        </div>
      </section>
    <% } %>
  </div>
</main>


<%- include('../partials/footer') %>
