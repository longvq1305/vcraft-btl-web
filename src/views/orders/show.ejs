<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<% const badge = getStatusBadge(order.status); %>
<main class="site-main order-detail-page">
  <div class="container">
    <nav class="breadcrumb-nav" aria-label="Đường dẫn">
      <ol class="breadcrumb-list">
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/orders">Đơn hàng</a></li>
        <li aria-current="page">#<%= order.id %></li>
      </ol>
    </nav>

    <div class="admin-page-header">
      <div>
        <div class="product-badges-row">
          <span class="slide-kicker">Phiếu Xác Nhận Đơn Mua Sẵn</span>
          <span class="badge <%= badge.className %>"><%= badge.label %></span>
        </div>
        <h1 class="page-title">Đơn hàng #<%= order.id %></h1>
        <div class="editorial-rule"></div>
      </div>
      <div class="admin-header-actions">
        <a href="/orders" class="btn btn-outline btn-sm">&larr; Danh sách đơn hàng</a>
        <% if (currentUser.role === 'buyer' && currentUser.id === order.buyer_id && order.status === 'placed') { %>
          <form action="/orders/<%= order.id %>/cancel" method="POST" class="inline-form" data-confirm="Bạn có chắc muốn hủy đơn hàng này?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="_method" value="PATCH">
            <button type="submit" class="btn btn-outline-danger btn-sm">Hủy đơn hàng</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="grid grid-2">
      <section class="card paper-panel">
        <h2 class="card-title">Thông tin tác phẩm</h2>
        <p class="order-product-heading"><strong><%= order.product_name %></strong></p>
        <dl class="order-detail-list">
          <dt>Số lượng</dt><dd><%= order.quantity %> chiếc</dd>
          <dt>Đơn giá lúc đặt</dt><dd><%= formatCurrency(order.unit_price) %></dd>
          <dt>Tổng thanh toán</dt><dd><strong class="text-primary"><%= formatCurrency(order.total_amount) %></strong></dd>
          <dt>Thời điểm đặt</dt><dd><time datetime="<%= order.created_at %>"><%= formatDate(order.created_at, true) %></time></dd>
        </dl>
        <% if (order.product_id && order.product_slug) { %>
          <div class="mt-3">
            <a href="/products/<%= encodeURIComponent(order.product_slug) %>" class="btn btn-outline btn-sm">Xem trang tác phẩm &rarr;</a>
          </div>
        <% } %>
      </section>
      <section class="card paper-panel">
        <h2 class="card-title">Thông tin giao nhận</h2>
        <dl class="order-detail-list">
          <dt>Người nhận</dt><dd><strong><%= order.recipient_name %></strong></dd>
          <dt>Số điện thoại</dt><dd><%= order.phone %></dd>
          <dt>Địa chỉ giao hàng</dt><dd><%= order.shipping_address %></dd>
          <% if (order.note) { %>
            <dt>Ghi chú đóng gói</dt><dd><%= order.note %></dd>
          <% } %>
        </dl>
      </section>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
