<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="site-main workshops-page">
  <div class="container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="Đường dẫn">
      <ol class="breadcrumb-list">
        <li><a href="/">Trang chủ</a></li>
        <li aria-current="page">Xưởng Thủ công & Nghệ nhân</li>
      </ol>
    </nav>

    <section class="editorial-page-hero editorial-page-hero--workshops">
      <div class="editorial-page-hero__inner">
        <span class="editorial-page-hero__eyebrow slide-kicker">Không Gian Sáng Tạo &amp; Làng Nghề</span>
        <h1 class="editorial-page-hero__title">
          Xưởng Thủ công &amp; Nghệ nhân Làng nghề
          <span class="editorial-page-hero__script display-script">Kỳ công</span>
        </h1>
        <div class="editorial-rule"></div>
        <p class="editorial-page-hero__desc">
          Khám phá không gian sáng tạo của các nghệ nhân, tìm hiểu văn hóa làng nghề và ghé thăm trực tiếp các xưởng nghề truyền thống.
        </p>
        <div class="header-action-group">
          <a href="/map" class="btn btn-outline">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
              <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
              <line x1="8" y1="2" x2="8" y2="18"></line>
              <line x1="16" y1="6" x2="16" y2="22"></line>
            </svg>
            Xem trên Bản đồ Làng nghề
          </a>
        </div>
      </div>
      <div class="editorial-page-hero__visual" aria-hidden="true">
        <div class="image-frame">
          <img src="/images/heritage/bamboo-craftsman.webp" alt="" loading="lazy">
        </div>
        <div class="image-frame">
          <img src="/images/heritage/basket-artisan.webp" alt="" loading="lazy">
        </div>
      </div>
    </section>

    <!-- Filter & Search Toolbar -->
    <section class="catalog-filters-section paper-panel" aria-label="Bộ lọc xưởng">
      <form action="/workshops" method="GET" class="filter-form">
        <div class="filter-row">
          <!-- Search input -->
          <div class="filter-group filter-search">
            <label for="workshop-search" class="filter-label">Tìm kiếm xưởng hoặc nghệ nhân</label>
            <div class="search-input-wrap">
              <input
                type="text"
                id="workshop-search"
                name="q"
                value="<%= searchQuery %>"
                placeholder="Tên xưởng, tên nghệ nhân, làng nghề, địa chỉ..."
                class="form-control"
              >
              <% if (searchQuery) { %>
                <a href="/workshops<%= selectedCategory ? '?category=' + encodeURIComponent(selectedCategory) : '' %>" class="clear-search-btn" title="Xóa tìm kiếm">&times;</a>
              <% } %>
            </div>
          </div>

          <!-- Category select -->
          <div class="filter-group">
            <label for="workshop-category" class="filter-label">Ngành nghề thủ công</label>
            <select id="workshop-category" name="category" class="form-control form-select">
              <option value="">Tất cả ngành nghề</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
              <% }); %>
            </select>
          </div>

          <!-- Actions -->
          <div class="filter-actions">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <% if (selectedCategory || searchQuery) { %>
              <a href="/workshops" class="btn btn-outline">Đặt lại</a>
            <% } %>
          </div>
        </div>
      </form>
    </section>

    <!-- Workshop Grid -->
    <% if (workshops && workshops.length > 0) { %>
      <div class="grid grid-2 workshop-grid">
        <% workshops.forEach(function(ws) { %>
          <article class="workshop-card">
            <a href="/workshops/<%= ws.slug %>" class="workshop-card-media">
              <img
                src="<%= ws.cover_image || 'https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=1000&q=80' %>"
                alt="<%= ws.workshop_name %>"
                class="workshop-card-img"
                loading="lazy"
              >
              <div class="workshop-status-tag <%= ws.is_open ? 'status-open' : 'status-closed' %>">
                <%= ws.is_open ? 'Đang mở cửa đón khách' : 'Tạm đóng cửa tham quan' %>
              </div>
            </a>
            <div class="workshop-card-body">
              <div class="workshop-artisan-sub">Nghệ nhân phụ trách: <strong><%= ws.artisan_name %></strong></div>
              <h2 class="workshop-card-title">
                <a href="/workshops/<%= ws.slug %>"><%= ws.workshop_name %></a>
              </h2>

              <% if (ws.address) { %>
                <p class="workshop-card-address">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-icon">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <%= ws.address %>
                </p>
              <% } %>

              <% if (ws.visiting_hours) { %>
                <p class="workshop-card-hours">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-icon">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  Giờ đón khách: <%= ws.visiting_hours %>
                </p>
              <% } %>

              <p class="workshop-card-story">
                <%= ws.story ? (ws.story.slice(0, 160) + (ws.story.length > 160 ? '...' : '')) : 'Xưởng gìn giữ nghề thủ công truyền thống.' %>
              </p>

              <div class="workshop-card-meta">
                <span class="meta-tag"><%= ws.categories || 'Thủ công mỹ nghệ' %></span>
                <span class="meta-count">
                  <a href="/catalog?workshop=<%= ws.slug %>"><%= ws.product_count || 0 %> tác phẩm đã xuất bản</a>
                </span>
              </div>

              <div class="workshop-card-footer">
                <a href="/workshops/<%= ws.slug %>" class="btn btn-primary btn-sm">Xem hồ sơ xưởng</a>
                <a href="/catalog?workshop=<%= ws.slug %>" class="btn btn-outline btn-sm">Xem tác phẩm</a>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
        <h3 class="empty-state-title">Không tìm thấy xưởng thủ công phù hợp</h3>
        <p class="empty-state-desc">Hãy thử xóa bộ lọc hoặc tìm kiếm với từ khóa khác.</p>
        <div class="empty-state-action">
          <a href="/workshops" class="btn btn-primary">Xem tất cả các xưởng</a>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
